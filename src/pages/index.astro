---
/**
 * 首页 /
 * 结构：Hero → 精选 3 篇 → 四张合集卡入口（任务书 §5）。
 * 精选不足 3 篇时，用其余文章按发布时间倒序补足，凑不满就只渲染现有的，不造假卡片。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PostCard from '../components/PostCard.astro';
import SeriesCard from '../components/SeriesCard.astro';
import { getCollection } from 'astro:content';
import { SERIES } from '../data/series';

const FEATURED_LIMIT = 3;

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// 精选优先：featured 按发布时间倒序取前 3，再用其余文章倒序补足（与已选中的去重）
const featured = posts.filter((post) => post.data.featured).slice(0, FEATURED_LIMIT);
const selected = [...featured];
const picked = new Set(selected.map((post) => post.id));
for (const post of posts) {
  if (selected.length >= FEATURED_LIMIT) break;
  if (picked.has(post.id)) continue;
  selected.push(post);
  picked.add(post.id);
}

// 每个合集的篇数
const seriesCounts: Record<string, number> = {};
for (const series of SERIES) seriesCounts[series.key] = 0;
for (const post of posts) seriesCounts[post.data.series] = (seriesCounts[post.data.series] ?? 0) + 1;
---

<BaseLayout title="大海学AI｜12 年开发 + 项目经理，公开记录学 AI 的每一步">
  <Hero />

  <div class="container">
    <section class="section">
      <div class="section-head">
        <h2>精选文章</h2>
        <a href="/posts/">全部文章 →</a>
      </div>

      <div class="grid-cards">
        {
          selected.map((post) => (
            <PostCard
              title={post.data.title}
              date={post.data.date}
              seriesKey={post.data.series}
              summary={post.data.summary}
              href={`/posts/${post.id}/`}
            />
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>四个合集</h2>
        <a href="/series/">合集总览 →</a>
      </div>

      <div class="grid-cards grid-cards--4">
        {
          SERIES.map((series) => (
            <SeriesCard series={series} count={seriesCounts[series.key] ?? 0} />
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
