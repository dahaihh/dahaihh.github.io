---
/**
 * PostCard · 文章卡片
 * 整卡渲染成 <a class="card">，点击进入文章详情。
 */
import SeriesTag from './SeriesTag.astro';
import { getSeries } from '../data/series';

interface Props {
  title: string;
  date?: Date;
  /** 合集 key */
  seriesKey?: string;
  summary?: string;
  href: string;
}

const { title, date, seriesKey, summary, href } = Astro.props;

const series = seriesKey ? getSeries(seriesKey) : undefined;
const isoDate = date ? date.toISOString().slice(0, 10) : undefined;
---

<a class="card post-card" href={href}>
  <div class="post-card-top">
    {series ? <SeriesTag seriesKey={series.key} /> : <span></span>}
    {isoDate && <time datetime={isoDate}>{isoDate}</time>}
  </div>

  <h3 class="post-card-title">{title}</h3>
  {summary && <p class="post-card-summary">{summary}</p>}

  <span class="post-card-more">阅读全文 →</span>
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .post-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    flex-wrap: wrap;
    min-height: 26px;
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  .post-card-title {
    margin: 0;
    font-size: 1.0625rem;
  }

  .post-card-summary {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9375rem;
    /* 摘要最多 3 行，卡片高度更整齐 */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-more {
    margin-top: auto;
    color: var(--brand);
    font-size: 0.875rem;
    font-weight: 600;
  }
</style>
