---
/**
 * BaseLayout · 全站最外层外壳
 * 职责：<html>/<head> 元信息、tokens.css + global.css 的全局引入、
 *       全局 header/footer、预留 <slot name="head" />（供 M4 注入 JSON-LD 等）。
 * 不负责页面题头与正文排版（那分别是 PageLayout / PostLayout 的事）。
 */
import '../styles/tokens.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE, VERIFICATION } from '../data/site';

interface Props {
  /** 页面标题；等于站点名时直接作为 <title>，否则追加「· 大海学AI」 */
  title: string;
  description?: string;
  /** 分享卡图片，站内绝对路径，默认回落 og-default.png */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** FR-13 结构化数据：单个对象或多段（数组）。传了就渲染成 application/ld+json */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  ogImage = '/og-default.png',
  ogType = 'website',
  jsonLd,
} = Astro.props;

const SITE_NAME = SITE.name;
const pageTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;

// 站长验证码：填了 src/data/site.ts 的 VERIFICATION 才会渲染，留空则一条都不出
const verificationMetas = [
  { name: 'google-site-verification', content: VERIFICATION.google },
  { name: 'msvalidate.01', content: VERIFICATION.bing },
  { name: 'baidu-site-verification', content: VERIFICATION.baidu },
].filter((meta) => meta.content !== '');

// site 已在 astro.config.mjs 配置；这里的兜底只为让类型收窄，不参与实际取值
const site = Astro.site ?? new URL('https://dahaihh.github.io');
const canonical = new URL(Astro.url.pathname, site);
const ogImageUrl = new URL(ogImage, site);

// 把 `<` 转义成 \u003c，避免正文里的 `</script>` 提前闭合脚本标签。
// 传数组时拆成多个 <script>，而不是塞一个顶层 JSON 数组（两者都合法，前者更常规、更好排查）
const jsonLdTexts = (Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []).map((item) =>
  JSON.stringify(item).replace(/</g, '\\u003c'),
);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E1016" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="大海学AI" href="/rss.xml" />

    <!-- M4：站长验证码，来源 src/data/site.ts -->
    {
      verificationMetas.map((meta) => (
        <meta name={meta.name} content={meta.content} />
      ))
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- FR-13：页级结构化数据 -->
    {
      jsonLdTexts.map((text) => (
        <script type="application/ld+json" set:html={text} />
      ))
    }

    <!-- M4：其余页级 <head> 注入走这里 -->
    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">跳到主内容</a>
    <SiteHeader />
    <main id="main" class="site-main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: var(--s-2) var(--s-4);
    background: var(--bg-elev);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
  }
  .skip-link:focus {
    left: var(--s-4);
    top: var(--s-4);
  }
</style>
